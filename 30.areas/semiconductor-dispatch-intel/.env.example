# 复制为 .env 后填写；不要提交或公开 .env。

# GitHub：未填也可运行，但速率较低。
# Token 只需要公开搜索/读取权限。
GITHUB_TOKEN=

# Reddit：当前脚本默认使用公开 RSS，不强制需要密钥。
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=obsidian-semiconductor-dispatch-intel/0.1

# X / Twitter：需要开发者账号 Bearer Token；未填则自动跳过 X。
X_BEARER_TOKEN=

# Semantic Scholar：可选；不填也可用公共额度，但可能遇到 429 限流。
SEMANTIC_SCHOLAR_API_KEY=

# PatentsView：可选；若后续接入结构化专利 API 时使用。
PATENTSVIEW_API_KEY=

# 可选：代理，例如 http://127.0.0.1:7890
HTTPS_PROXY=
HTTP_PROXY=
