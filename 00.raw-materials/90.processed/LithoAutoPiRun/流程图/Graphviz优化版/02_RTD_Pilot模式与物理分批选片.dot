digraph RTDPilotMode {
  graph [
    charset="UTF-8",
    rankdir=TB,
    splines=ortho,
    bgcolor="white",
    pad=0.25,
    nodesep=0.48,
    ranksep=0.66,
    fontname="Microsoft YaHei",
    fontsize=15,
    labelloc="t",
    label="RTD Pilot 模式与物理分批选片"
  ];
  node [
    shape=box,
    style="solid",
    color="black",
    fontcolor="black",
    fontname="Microsoft YaHei",
    fontsize=11,
    margin="0.16,0.10"
  ];
  edge [
    color="black",
    fontcolor="black",
    fontname="Microsoft YaHei",
    fontsize=10,
    arrowsize=0.7
  ];

  start [label="取得已选 Lot+Context"];
  whole_rule [shape=diamond, label="任一整批条件成立？"];
  whole [label="IsNeedSplit=F"];
  whole_out [label="整批设为 Pilot"];
  split [label="IsNeedSplit=T"];
  read_cnt [label="读取 pi_splitcnt"];
  invalid_cnt [shape=diamond, label="分片数无效？"];
  default_cnt [label="使用默认值 4"];
  config_cnt [label="使用配置值"];
  enough [shape=diamond, label="可用 Wafer 足够？"];
  group [label="建立 Group/SubGroup"];
  rank [label="计算 GroupRank/WaferRank"];
  choose [label="按排序选择 Wafer"];
  adi [shape=diamond, label="存在非 SRC 的 ADI？"];
  first_adi [label="首道 ADI 为 Merge"];
  last_cd [label="末道 CD 为 Merge"];
  output [label="输出分批参数 Report"];

  start -> whole_rule;
  whole_rule -> whole [xlabel="是"];
  whole -> whole_out;
  whole_rule -> split [xlabel="否"];
  split -> read_cnt -> invalid_cnt;
  invalid_cnt -> default_cnt [xlabel="是"];
  invalid_cnt -> config_cnt [xlabel="否"];
  default_cnt -> enough;
  config_cnt -> enough;
  enough -> whole [xlabel="否"];
  enough -> group [xlabel="是"];
  group -> rank -> choose -> adi;
  adi -> first_adi [xlabel="是"];
  adi -> last_cd [xlabel="否"];
  first_adi -> output;
  last_cd -> output;
}
