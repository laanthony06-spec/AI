digraph RTDPilotMode {
  graph [
    charset="UTF-8",
    rankdir=TB,
    splines=ortho,
    bgcolor="white",
    pad=0.25,
    nodesep=0.48,
    ranksep=0.66,
    fontname="Microsoft YaHei",
    fontsize=15,
    labelloc="t",
    label="RTD Pilot 模式与物理分批选片"
  ];
  node [
    shape=box,
    style="solid",
    color="black",
    fontcolor="black",
    fontname="Microsoft YaHei",
    fontsize=11,
    margin="0.16,0.10"
  ];
  edge [
    color="black",
    fontcolor="black",
    fontname="Microsoft YaHei",
    fontsize=10,
    arrowsize=0.7
  ];

  start [label="取得已选 Lot+Context"];
  whole_rule [shape=diamond, label="需要物理分批？"];
  whole [label="IsNeedSplit=F"];
  whole_out [label="整批设为 Pilot"];
  split [label="IsNeedSplit=T"];
  read_cnt [label="读取 pi_splitcnt"];
  resolve_cnt [label="确定分片数：有效用配置，否则默认 4"];
  enough [shape=diamond, label="可用 Wafer 足够？"];
  fallback_whole [label="IsNeedSplit=F"];
  fallback_out [label="Wafer 不足，整批设为 Pilot"];
  group [label="建立 Group/SubGroup"];
  rank [label="计算 GroupRank/WaferRank"];
  choose [label="按排序选择 Wafer"];
  adi [shape=diamond, label="存在非 SRC 的 ADI？"];
  first_adi [label="首道 ADI 为 Merge"];
  last_cd [label="末道 CD 为 Merge"];
  output_adi [label="按首道 ADI 输出分批 Report"];
  output_cd [label="按末道 CD 输出分批 Report"];

  start:s -> whole_rule:n;
  { rank=same; whole_rule; whole; }
  whole_rule:e -> whole:w [xlabel="否", constraint=false];
  whole:s -> whole_out:n;
  whole_rule:s -> split:n [xlabel="是"];
  split:s -> read_cnt:n;
  read_cnt:s -> resolve_cnt:n;
  resolve_cnt:s -> enough:n;
  { rank=same; enough; fallback_whole; }
  enough:e -> fallback_whole:w [xlabel="否", constraint=false];
  fallback_whole:s -> fallback_out:n;
  enough:s -> group:n [xlabel="是"];
  group:s -> rank:n;
  rank:s -> choose:n;
  choose:s -> adi:n;
  adi:s -> first_adi:n [xlabel="是"];
  { rank=same; adi; last_cd; }
  adi:e -> last_cd:w [xlabel="否", constraint=false];
  first_adi:s -> output_adi:n;
  last_cd:s -> output_cd:n;
}
