digraph LithoAutoPiRunOverview {
  graph [
    charset="UTF-8",
    rankdir=TB,
    splines=ortho,
    bgcolor="white",
    pad=0.25,
    nodesep=0.45,
    ranksep=0.65,
    newrank=true,
    fontname="Microsoft YaHei",
    fontsize=15,
    labelloc="t",
    label="LithoAutoPiRun 端到端主流程"
  ];
  node [
    shape=box,
    style="solid",
    color="black",
    fontcolor="black",
    fontname="Microsoft YaHei",
    fontsize=11,
    margin="0.16,0.10"
  ];
  edge [
    color="black",
    fontcolor="black",
    fontname="Microsoft YaHei",
    fontsize=10,
    arrowsize=0.7
  ];

  subgraph cluster_pilot {
    label="链路 A：Pilot 生成与派工";
    color="black";
    penwidth=1;
    margin=18;

    a_start [label="触发 Pilot 计算"];
    a_rtd [label="RTD 筛选最佳 Pilot"];
    a_found [shape=diamond, label="存在可用 Pilot？"];
    a_wait [label="等待下一轮"];
    a_report [label="输出 Pilot Report"];
    a_ama [label="AMA 读取 Report"];
    a_split [shape=diamond, label="需要物理分批？"];
    a_whole [label="整批设为 Pilot"];
    a_phy [label="执行物理分批子流程"];
    a_whole_r2r [label="整批 Pilot 传给 R2R"];
    a_whole_control [label="执行卡控并按结果处理"];
    a_phy_r2r [label="子批 Pilot 传给 R2R"];
    a_phy_control [label="执行 Rule/Assign 卡控"];
    a_phy_allow [shape=diamond, label="允许继续作业？"];
    a_phy_hold [label="子批保持卡控"];
    a_phy_end [label="子批进入 PiRun"];

    a_start:s -> a_rtd:n;
    a_rtd:s -> a_found:n;
    { rank=same; a_found; a_wait; }
    a_found:e -> a_wait:w [xlabel="否", constraint=false];
    a_found:s -> a_report:n [xlabel="是"];
    a_report:s -> a_ama:n;
    a_ama:s -> a_split:n;
    { rank=same; a_split; a_whole; }
    a_split:e -> a_whole:w [xlabel="否", constraint=false];
    a_split:s -> a_phy:n [xlabel="是"];
    a_whole:s -> a_whole_r2r:n;
    a_whole_r2r:s -> a_whole_control:n;
    a_phy:s -> a_phy_r2r:n;
    a_phy_r2r:s -> a_phy_control:n;
    a_phy_control:s -> a_phy_allow:n;
    { rank=same; a_phy_allow; a_phy_hold; }
    a_phy_allow:e -> a_phy_hold:w [xlabel="否", constraint=false];
    a_phy_allow:s -> a_phy_end:n [xlabel="是"];
  }

  subgraph cluster_foup {
    label="链路 B：Transfer FOUP 与临时卡控";
    color="black";
    penwidth=1;
    margin=18;

    b_start [label="WatchDog 周期触发"];
    b_report [label="生成 TransferFOUP Report"];
    b_has [shape=diamond, label="存在待转 Carrier？"];
    b_none [label="本轮结束"];
    b_hold [label="新增 WaitPilotChangeFOUP"];
    b_transfer [label="AMA 执行 TransferFOUP"];
    b_remove [label="按站点与 Qtime 解除"];
    b_end [label="本轮处理完成"];

    b_start:s -> b_report:n;
    b_report:s -> b_has:n;
    { rank=same; b_has; b_none; }
    b_has:e -> b_none:w [xlabel="否", constraint=false];
    b_has:s -> b_hold:n [xlabel="是"];
    b_hold:s -> b_transfer:n;
    b_transfer:s -> b_remove:n;
    b_remove:s -> b_end:n;
  }
}
