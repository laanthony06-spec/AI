digraph WaitPilotChangeFoupRelease {
  graph [
    charset="UTF-8",
    rankdir=TB,
    splines=ortho,
    bgcolor="white",
    pad=0.25,
    nodesep=0.5,
    ranksep=0.68,
    fontname="Microsoft YaHei",
    fontsize=15,
    labelloc="t",
    label="WaitPilotChangeFOUP 解除规则"
  ];
  node [
    shape=box,
    style="solid",
    color="black",
    fontcolor="black",
    fontname="Microsoft YaHei",
    fontsize=11,
    margin="0.16,0.10"
  ];
  edge [
    color="black",
    fontcolor="black",
    fontname="Microsoft YaHei",
    fontsize=10,
    arrowsize=0.7
  ];

  subgraph cluster_pilot {
    label="Pilot 对象";
    color="black";
    pilot_start [label="检查 Pilot 卡控"];
    pilot_release [shape=diamond, label="RemainQ<4h 或 Qu_0？"];
    pilot_remove [label="解除 Pilot 卡控"];
    pilot_keep [label="保持 Pilot 卡控"];

    pilot_start:s -> pilot_release:n;
    pilot_release:s -> pilot_remove:n [xlabel="是"];
    { rank=same; pilot_release; pilot_keep; }
    pilot_release:e -> pilot_keep:w [xlabel="否", constraint=false];
  }

  subgraph cluster_litho {
    label="Litho Other Lot";
    color="black";
    litho_start [label="检查 Litho Other Lot"];
    litho_keep [label="保持卡控"];

    litho_start:s -> litho_keep:n;
  }

  subgraph cluster_barco {
    label="BARCO Other Lot";
    color="black";
    barco_start [label="检查 BARCO Other Lot"];
    barco_release [shape=diamond, label="RemainQ<4h 或 Qu_0？"];
    barco_remove [label="解除 BARCO 卡控"];
    barco_keep [label="保持 BARCO 卡控"];

    barco_start:s -> barco_release:n;
    barco_release:s -> barco_remove:n [xlabel="是"];
    { rank=same; barco_release; barco_keep; }
    barco_release:e -> barco_keep:w [xlabel="否", constraint=false];
  }

  subgraph cluster_other {
    label="其他站 Other Lot";
    color="black";
    other_start [label="检查其他站 Other Lot"];
    other_release [shape=diamond, label="触发 Qu_0？"];
    other_remove [label="解除其他站卡控"];
    other_keep [label="保持其他站卡控"];

    other_start:s -> other_release:n;
    other_release:s -> other_remove:n [xlabel="是"];
    { rank=same; other_release; other_keep; }
    other_release:e -> other_keep:w [xlabel="否", constraint=false];
  }
}
