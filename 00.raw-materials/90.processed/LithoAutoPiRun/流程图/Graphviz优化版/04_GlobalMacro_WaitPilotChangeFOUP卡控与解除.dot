digraph WaitPilotChangeFoup {
  graph [
    charset="UTF-8",
    rankdir=TB,
    splines=ortho,
    bgcolor="white",
    pad=0.25,
    nodesep=0.5,
    ranksep=0.68,
    fontname="Microsoft YaHei",
    fontsize=15,
    labelloc="t",
    label="Global Macro：WaitPilotChangeFOUP 卡控与解除"
  ];
  node [
    shape=box,
    style="solid",
    color="black",
    fontcolor="black",
    fontname="Microsoft YaHei",
    fontsize=11,
    margin="0.16,0.10"
  ];
  edge [
    color="black",
    fontcolor="black",
    fontname="Microsoft YaHei",
    fontsize=10,
    arrowsize=0.7
  ];

  start [label="获取待转 FOUP 的 Pilot"];
  active [shape=diamond, label="WatchDog 有效且到时？"];
  no_hold [label="不新增卡控"];
  in_sorter [shape=diamond, label="Pilot 在 Sorter？"];
  hold_other [label="卡控非 Sorter Other Lot"];
  hold_both [label="卡控 Pilot+非 Sorter Lot"];
  monitor_other [label="持续检查 Other Lot 解除条件"];
  release_other [label="执行 Other Lot 独立解除规则"];
  result_other [label="解除或保持 Other Lot 卡控"];
  monitor_both [label="持续检查两类对象解除条件"];
  release_both [label="分别执行独立解除规则"];
  result_both [label="分别解除或保持卡控"];

  start:s -> active:n;
  { rank=same; active; no_hold; }
  active:e -> no_hold:w [xlabel="否", constraint=false];
  active:s -> in_sorter:n [xlabel="是"];
  in_sorter:s -> hold_other:n [xlabel="是"];
  { rank=same; in_sorter; hold_both; }
  in_sorter:e -> hold_both:w [xlabel="否", constraint=false];
  hold_other:s -> monitor_other:n;
  monitor_other:s -> release_other:n;
  release_other:s -> result_other:n;
  hold_both:s -> monitor_both:n;
  monitor_both:s -> release_both:n;
  release_both:s -> result_both:n;
}
