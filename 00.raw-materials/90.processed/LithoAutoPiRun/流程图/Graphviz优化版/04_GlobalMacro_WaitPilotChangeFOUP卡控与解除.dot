digraph WaitPilotChangeFoup {
  graph [
    charset="UTF-8",
    rankdir=TB,
    splines=ortho,
    bgcolor="white",
    pad=0.25,
    nodesep=0.5,
    ranksep=0.68,
    fontname="Microsoft YaHei",
    fontsize=15,
    labelloc="t",
    label="Global Macro：WaitPilotChangeFOUP 卡控与解除"
  ];
  node [
    shape=box,
    style="solid",
    color="black",
    fontcolor="black",
    fontname="Microsoft YaHei",
    fontsize=11,
    margin="0.16,0.10"
  ];
  edge [
    color="black",
    fontcolor="black",
    fontname="Microsoft YaHei",
    fontsize=10,
    arrowsize=0.7
  ];

  start [label="获取待转 FOUP 的 Pilot"];
  active [shape=diamond, label="WatchDog 有效且到时？"];
  no_hold [label="不新增卡控"];
  in_sorter [shape=diamond, label="Pilot 在 Sorter？"];
  hold_other [label="卡控非 Sorter Other Lot"];
  hold_both [label="卡控 Pilot+非 Sorter Lot"];
  monitor [label="持续检查解除条件"];
  release_sub [label="执行独立解除规则"];
  result [label="解除或保持卡控"];

  start -> active;
  active -> no_hold [xlabel="否"];
  active -> in_sorter [xlabel="是"];
  in_sorter -> hold_other [xlabel="是"];
  in_sorter -> hold_both [xlabel="否"];
  hold_other -> monitor;
  hold_both -> monitor;
  monitor -> release_sub -> result;
}
