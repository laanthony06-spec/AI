digraph RTDPilotSelection {
  graph [
    charset="UTF-8",
    rankdir=TB,
    splines=ortho,
    bgcolor="white",
    pad=0.25,
    nodesep=0.45,
    ranksep=0.62,
    fontname="Microsoft YaHei",
    fontsize=15,
    labelloc="t",
    label="RTD 候选过滤与 Pilot 选择"
  ];
  node [
    shape=box,
    style="solid",
    color="black",
    fontcolor="black",
    fontname="Microsoft YaHei",
    fontsize=11,
    margin="0.16,0.10"
  ];
  edge [
    color="black",
    fontcolor="black",
    fontname="Microsoft YaHei",
    fontsize=10,
    arrowsize=0.7
  ];

  start [label="获取 FAB6/FAB8 候选 Lot"];
  base [label="获取 Lot 基础信息"];
  base_filter [label="执行基础过滤与去重"];
  base_left [shape=diamond, label="仍有候选 Lot？"];
  loop [label="构建 20 站 PirunLoop"];
  loop_filter [label="执行 Loop 条件过滤"];
  loop_left [shape=diamond, label="仍有候选 Lot？"];
  specify [shape=diamond, label="属于非 Specify Lot？"];
  specify_flow [label="转现有 Specify 处理"];
  tools [label="获取并筛选可作业机台"];
  context [label="匹配有效 R2R Context"];
  context_ok [shape=diamond, label="存在单一路径 Context？"];
  auto_context [label="筛选 AutoPirun Context"];
  auto_ok [shape=diamond, label="存在待 Pirun Context？"];
  rtd_rank [label="计算 Lot 的 RTDRank"];
  context_rank [label="计算 Context 排序指标"];
  select [label="锁定首位 Lot+Context"];
  remove [label="移除重复 Lot/Context"];
  remain [shape=diamond, label="全部候选处理完成？"];
  update [label="循环更新排序并处理候选"];
  output [label="输出各 Context 最优 Pilot"];
  output_loop [label="循环完成后输出最优 Pilot"];
  reject_base [label="无基础候选，过滤该 Lot"];
  reject_loop [label="Loop 后无候选，过滤该 Lot"];
  reject_context [label="无单一路径，过滤该 Lot"];
  reject_auto [label="无待 Pirun Context，过滤该 Lot"];

  start:s -> base:n;
  base:s -> base_filter:n;
  base_filter:s -> base_left:n;
  { rank=same; base_left; reject_base; }
  base_left:e -> reject_base:w [xlabel="否", constraint=false];
  base_left:s -> loop:n [xlabel="是"];
  loop:s -> loop_filter:n;
  loop_filter:s -> loop_left:n;
  { rank=same; loop_left; reject_loop; }
  loop_left:e -> reject_loop:w [xlabel="否", constraint=false];
  loop_left:s -> specify:n [xlabel="是"];
  { rank=same; specify; specify_flow; }
  specify:e -> specify_flow:w [xlabel="否", constraint=false];
  specify:s -> tools:n [xlabel="是"];
  tools:s -> context:n;
  context:s -> context_ok:n;
  { rank=same; context_ok; reject_context; }
  context_ok:e -> reject_context:w [xlabel="否", constraint=false];
  context_ok:s -> auto_context:n [xlabel="是"];
  auto_context:s -> auto_ok:n;
  { rank=same; auto_ok; reject_auto; }
  auto_ok:e -> reject_auto:w [xlabel="否", constraint=false];
  auto_ok:s -> rtd_rank:n [xlabel="是"];
  rtd_rank:s -> context_rank:n;
  context_rank:s -> select:n;
  select:s -> remove:n;
  remove:s -> remain:n;
  remain:s -> output:n [xlabel="是"];
  { rank=same; remain; update; }
  remain:e -> update:w [xlabel="否", constraint=false];
  update:s -> output_loop:n;
}
