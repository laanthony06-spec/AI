digraph AMATransferFoup {
  graph [
    charset="UTF-8",
    rankdir=TB,
    splines=ortho,
    bgcolor="white",
    pad=0.25,
    nodesep=0.5,
    ranksep=0.68,
    fontname="Microsoft YaHei",
    fontsize=15,
    labelloc="t",
    label="AMA TransferFOUP 执行"
  ];
  node [
    shape=box,
    style="solid",
    color="black",
    fontcolor="black",
    fontname="Microsoft YaHei",
    fontsize=11,
    margin="0.16,0.10"
  ];
  edge [
    color="black",
    fontcolor="black",
    fontname="Microsoft YaHei",
    fontsize=10,
    arrowsize=0.7
  ];

  start [label="读取 TransferFOUP Report"];
  has [shape=diamond, label="存在待处理记录？"];
  read [label="按顺序读取下一条"];
  reserve [label="获取可用空 FOUP"];
  reserve_ok [shape=diamond, label="空 FOUP 可用且非零？"];
  transfer [label="调用 MES TransferFOUP"];
  transfer_ok [shape=diamond, label="接口调用成功？"];
  fail [label="在 AMALog 记录 Fail"];
  success [label="记录当前处理成功"];
  mark [label="当前记录处理结束"];
  remain [shape=diamond, label="仍有下一条记录？"];
  end [label="本轮执行结束"];

  start -> has;
  has -> end [xlabel="否"];
  has -> read [xlabel="是"];
  read -> reserve -> reserve_ok;
  reserve_ok -> fail [xlabel="否"];
  reserve_ok -> transfer [xlabel="是"];
  transfer -> transfer_ok;
  transfer_ok -> fail [xlabel="否"];
  transfer_ok -> success [xlabel="是"];
  fail -> mark;
  success -> mark;
  mark -> remain;
  remain -> end [xlabel="否"];
  remain -> read [xlabel="是"];
}
